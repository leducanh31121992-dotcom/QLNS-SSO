<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <log4net>
    <appender name="LogFileErrorAppender" type="log4net.Appender.RollingFileAppender">
      <file value="C:\Temp\QLNSError.log" />
      <encoding value="utf-8" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <datePattern value="_dd_MM_yyyy'.log'" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{yyyy.MM.dd hh:mm:ss fff} %-5p [%stacktrace{level}:%L] - %m%n" />
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="ERROR" />
        <levelMax value="ERROR" />
      </filter>
    </appender>

    <appender name="LogFileWarnAppender" type="log4net.Appender.RollingFileAppender">
      <file value="C:\Temp\QLNSWarn.log" />
      <encoding value="utf-8" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <datePattern value="_dd_MM_yyyy'.log'" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{yyyy.MM.dd hh:mm:ss fff} %-5p [%method:%L] - %m%n" />
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="WARN" />
        <levelMax value="WARN" />
      </filter>
    </appender>

    <appender name="LogFileDebugAppender" type="log4net.Appender.RollingFileAppender">
      <file value="C:\Temp\QLNSWarn.log" />
      <encoding value="utf-8" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <datePattern value="_dd_MM_yyyy'.log'" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{yyyy.MM.dd hh:mm:ss fff} %-5p [%method:%L] - %m%n" />
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="DEBUG" />
        <levelMax value="DEBUG" />
      </filter>
    </appender>

    <appender name="LogFileInfoAppender" type="log4net.Appender.RollingFileAppender">
      <file value="C:\Temp\QLNSInfo.log" />
      <encoding value="utf-8" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <datePattern value="_dd_MM_yyyy'.log'" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{yyyy.MM.dd hh:mm:ss fff} %-5p [%method:%L] - %m%n" />
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="INFO" />
        <levelMax value="INFO" />
      </filter>
    </appender>

    <appender name="LogFileFatalppender" type="log4net.Appender.RollingFileAppender">
      <file value="C:\Temp\QLNSFatal.log" />
      <encoding value="utf-8" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="30" />
      <maximumFileSize value="20MB" />
      <staticLogFileName value="true" />
      <datePattern value="_dd_MM_yyyy'.log'" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d{yyyy.MM.dd hh:mm:ss fff} [%t] %-5p %c{1}:%L - %m%n" />
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="FATAL" />
        <levelMax value="FATAL" />
      </filter>
    </appender>
    <logger name="Log4NetQLNS">
      <level value="ALL" />
      <appender-ref ref="LogFileErrorAppender" />
      <appender-ref ref="LogFileDebugAppender" />
      <appender-ref ref="LogFileInfoAppender" />
      <appender-ref ref="LogFileWarnAppender" />
      <appender-ref ref="LogFileFatalppender" />
    </logger>

    <!--<root>
      <level value="ALL" />
      <appender-ref ref="LogFileErrorAppender" />
      <appender-ref ref="LogFileDebugAppender" />
      <appender-ref ref="LogFileInfoAppender" />
      <appender-ref ref="LogFileWarnAppender" />
      <appender-ref ref="LogFileFatalppender" />
    </root>-->
  </log4net>
</configuration>