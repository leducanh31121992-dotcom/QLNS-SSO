<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.diagnostics>
		<sources>
			<!-- This section defines the logging configuration for My.Application.Log -->
			<source name="DefaultSource" switchName="DefaultSwitch">
				<listeners>
					<add name="FileLog" />
					<!-- Uncomment the below section to write to the Application Event Log -->
					<!--<add name="EventLog"/>-->
				</listeners>
			</source>
		</sources>
		<switches>
			<add name="DefaultSwitch" value="Information" />
		</switches>
		<sharedListeners>
			<add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter" />
			<!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
			<!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
		</sharedListeners>
	</system.diagnostics>

	<appSettings>
		<add key="HSC" value="1" />
		<add key="TINH" value="2" />
		<add key="VPDD" value="3" />
		<add key="HUYEN" value="4" />
		<add key="TTCNTT" value="5" />
		<add key="TTDT" value="7" />
		<add key="SGD" value="9" />
		<add key="Server" value="localhost" />
		<add key="Database" value="QLNS_NHCSXH_202507" />
		<add key="User" value="sa" />
		<add key="Password" value="1q2w3e4r5t6y" />
		<add key="File_Excel_Template" value="\FileExcels\" />
		<add key="ClientSettingsProvider.ServiceUri" value="" />

		<!-- === Cấu hình SSO & API Server bổ sung === -->
		<add key="SSO_BaseUrl" value="http://10.63.48.185" />
		<add key="SSO_ClientId" value="QLNS" />
		<add key="SSO_ClientSecret" value="FswQmPPERlrb3nKlGU9exL69OHQMpoae" />
		<add key="SSO_RedirectUri" value="http://localhost:3112/QLNS/" />
		<add key="SSO_Scope" value="openid profile email" />
		<add key="SSO_CodeVerifier" value="pw19dsP6jNTwRet5YMPolX_suWgZzyXNZY4wBpHIEWdHWCR4k7Jn4gEpkcLcjuKO" />
		<add key="SSO_State" value="6e4cfa71ee572b1bec4f54aac45efbc7" />
		<add key="SSO_Nonce" value="acb91979d5a1af7c1a99adce29669c4e" />
		<add key="SSO_CodeChallenge" value="W3_uiYNmMOrdjVHh0nGtSyJcSwv-vnJPKmDaxtqGUC0" />
